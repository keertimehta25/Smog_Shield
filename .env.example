# Copy this file to `.env` for local development. NEVER commit `.env`.
# Every value below is a placeholder. Put real secrets only in your own .env
# or in your hosting provider's environment settings.

NODE_ENV=development
PORT=8787

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Google Gemini API key (https://aistudio.google.com/apikey). Server-side only.
# If left empty, the app still works using its built-in rule-based advisor.
GEMINI_API_KEY= 
# Model is configuration, not code: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.6-flash
# Models to try, in order, if GEMINI_MODEL is retired or overloaded. Leave unset to use the built-in
# chain (gemini-3.6-flash, 3.5-flash, flash-latest, 2.5-flash, 2.5-flash-lite).
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash
# Per-request timeout for one model call, and the total time allowed across all models (ms).
AI_TIMEOUT_MS=20000
AI_TOTAL_BUDGET_MS=45000

# Number of reverse proxies in front of the app. Production defaults to 1 (correct for Render and
# Cloud Run); development defaults to 0. Set explicitly only if your host differs.
# TRUST_PROXY=1
